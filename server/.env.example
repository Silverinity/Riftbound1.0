# Copy this file to .env for local development.
# Never commit your real .env file or share your Discord Client Secret.

PORT=3000
NODE_ENV=development

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=put_your_client_id_here
DISCORD_CLIENT_SECRET=put_your_client_secret_here
# Must exactly match the redirect URL configured in Discord.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Riftbound Discord server and Beta Tester role
DISCORD_GUILD_ID=1573092916497350756
DISCORD_BETA_ROLE_ID=1573094754651209748

# Frontend origin, with no trailing slash.
# Change this to the local address used by your VS Code preview.
FRONTEND_ORIGIN=http://localhost:5500

# Generate a long random secret (at least 32 characters).
# Do not reuse your Discord Client Secret here.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
